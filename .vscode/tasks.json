{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: dependências",
      "type": "shell",
      "command": "flutter",
      "args": [
        "pub",
        "get"
      ],
      "options": {
        "env": {
          "CI": "true",
          "FLUTTER_SUPPRESS_ANALYTICS": "true"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "ImagoHub: API",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "server/server.py"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "imagohub",
        "pattern": {
          "regexp": "^(__never_a_diagnostic__)()$",
          "file": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "^ImagoHub API pronta.*"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ImagoHub: preparar",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Flutter: dependências",
        "ImagoHub: API"
      ],
      "problemMatcher": []
    },
    {
      "label": "ImagoHub: testes",
      "type": "shell",
      "command": "flutter",
      "args": [
        "test",
        "--dart-define=REFERENCE_MODE=true"
      ],
      "options": {
        "env": {
          "CI": "true",
          "FLUTTER_SUPPRESS_ANALYTICS": "true"
        }
      },
      "problemMatcher": []
    }
  ]
}
